                    RowBox[{"mCoef", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "i"}], "]"}], "]"}], "*", 
                    RowBox[{"x", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}]}], ")"}], "/", 
                   RowBox[{"mCoef", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "i"}], "]"}], "]"}]}]}]}]}]}], 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{
                "consideramos", " ", "la", " ", "expresi\[OAcute]n", " ", 
                 "de", " ", "la", " ", "coordenada", " ", "i"}], "-", 
                RowBox[{
                "\[EAcute]sima", " ", "en", " ", "el", " ", "iterado", " ", 
                 "que", " ", "se", " ", "est\[AAcute]", " ", "calculando"}]}],
                "*)"}], "\[IndentingNewLine]", "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"error", "=", 
              RowBox[{"fError", "[", "x", "]"}]}], 
