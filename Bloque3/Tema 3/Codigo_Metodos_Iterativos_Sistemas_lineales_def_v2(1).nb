             "\[IndentingNewLine]", 
             RowBox[{"iter", "=", 
              RowBox[{"iter", "+", "1"}]}]}]}], 
           RowBox[{"(*", 
            RowBox[{"actualiza", " ", "el", " ", "iterador"}], "*)"}], 
           "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
