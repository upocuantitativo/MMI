             " ", "de", " ", "ese", " ", "modo", " ", "utiliza", " ", "el", 
            " ", "\[UAcute]ltimo", " ", "valor", " ", "calculado", " ", "de", 
            " ", "cada", " ", "variable"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"While", "[", 
