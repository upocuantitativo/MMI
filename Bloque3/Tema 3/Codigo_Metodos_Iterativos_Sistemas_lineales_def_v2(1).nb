                  RowBox[{"x", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], "+", 
                 RowBox[{"w", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"bInd", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", 
                    RowBox[{"Sum", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"mCoef", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
                    RowBox[{"x", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}], "+", 
