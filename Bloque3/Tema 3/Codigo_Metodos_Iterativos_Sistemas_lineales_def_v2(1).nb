           RowBox[{"iter", "=", 
            RowBox[{"iter", "+", "1"}]}]}]}], 
         RowBox[{"(*", 
          RowBox[{"actualiza", " ", "el", " ", "iterador"}], "*)"}], 
         "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"metodo", "\[Equal]", "3"}], ",", "\[IndentingNewLine]", 
