           RowBox[{"T", ".", " ", "Define"}], " ", "una", " ", 
           "funci\[OAcute]n", " ", "que", " ", "calcula", " ", "el", " ", 
           "radio", " ", "espectral"}], "*)"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"rhoT", "<", "1"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{
             "\"\<El m\[EAcute]todo de Gauss-Seidel es convergente para la \
matriz \>\"", ",", "mCoef", ",", 
              "\"\< y se procede al c\[AAcute]lculo de la \
aproximaci\[OAcute]n de su soluci\[OAcute]n.\>\""}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{"error", ">", "tol"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"x", "=", 
                RowBox[{
                 RowBox[{"t", ".", "x0"}], "+", 
                 RowBox[{"inversaD", ".", "bInd"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"error", "=", 
                RowBox[{"Norm", "[", 
                 RowBox[{
                  RowBox[{"x", "-", "x0"}], ",", "Infinity"}], "]"}]}], 
               RowBox[{"(*", 
                RowBox[{
                "construido", " ", "el", " ", "iterado", " ", "en", " ", 
                 "esta", " ", "iteraci\[OAcute]n"}], "*)"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"x0", "=", "x"}], 
               RowBox[{"(*", 
                RowBox[{
                "actualiza", " ", "el", " ", "iterado", " ", "anterior", " ", 
                 "de", " ", "la", " ", "siguiente", " ", 
                 "iteraci\[OAcute]n"}], "*)"}], ";", "\[IndentingNewLine]", 
