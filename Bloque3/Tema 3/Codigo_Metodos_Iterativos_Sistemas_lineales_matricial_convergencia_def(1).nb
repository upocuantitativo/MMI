            "\"\<Se ha seleccionado el m\[EAcute]todo de relajaci\[OAcute]n \
comenzando en iterado inicial x0=\>\"", ",", "x0", ",", "\"\<, con w=\>\"", 
             ",", "w", ",", 
             "\"\< y considerando un criterio de parada consistente en \>\"", 
             ",", 
             RowBox[{"criterio", "<>", 
              RowBox[{"ToString", "[", "tol", "]"}]}]}], 
            "\[IndentingNewLine]", "]"}], ";", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
             "resumen", " ", "toda", " ", "la", " ", "informaci\[OAcute]n", 
              " ", "del", " ", "m\[EAcute]todo"}], ",", " ", 
             RowBox[{
             "iterado", " ", "inicial", " ", "y", " ", "criterio", " ", "de", 
              " ", "parada"}]}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"inversaD", "=", 
            RowBox[{"Inverse", "[", 
             RowBox[{
              RowBox[{"LowerTriangularize", "[", "mCoef", "]"}], "+", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", "w"}], ")"}], "/", "w"}], "*", 
               RowBox[{"DiagonalMatrix", "[", 
                RowBox[{"Diagonal", "[", "mCoef", "]"}], "]"}]}]}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"t", "=", 
            RowBox[{"inversaD", ".", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"LowerTriangularize", "[", "mCoef", "]"}], "+", 
