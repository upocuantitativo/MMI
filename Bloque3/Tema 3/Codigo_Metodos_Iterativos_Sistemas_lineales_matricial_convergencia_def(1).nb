               "\[IndentingNewLine]", 
               RowBox[{"iter", "=", 
                RowBox[{"iter", "+", "1"}]}]}]}], 
             RowBox[{"(*", 
              RowBox[{"actualiza", " ", "el", " ", "iterador"}], "*)"}], 
             "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<El m\[EAcute]todo de Gauss-Seidel no es convergente para a \
