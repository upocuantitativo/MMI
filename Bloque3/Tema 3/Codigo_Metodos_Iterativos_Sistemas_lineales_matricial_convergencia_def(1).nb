                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "-", "w"}], ")"}], "/", "w"}], "*", 
                RowBox[{"DiagonalMatrix", "[", 
                 RowBox[{"Diagonal", "[", "mCoef", "]"}], "]"}]}], "-", 
               "mCoef"}], ")"}]}]}], 
           RowBox[{"(*", 
            RowBox[{
            "construye", " ", "matriz", " ", "T", " ", "del", " ", 
             "m\[EAcute]todo"}], "*)"}], ";", 
           RowBox[{"auto", "=", 
            RowBox[{"Eigenvalues", "[", "t", "]"}]}], 
           RowBox[{"(*", 
            RowBox[{"calcula", " ", "autovalores", " ", "de", " ", "T"}], 
            "*)"}], " ", ";", "\[IndentingNewLine]", 
           RowBox[{"rhoT", "=", 
