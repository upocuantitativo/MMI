  RowBox[{"(*", 
   RowBox[{
   "Se", " ", "define", " ", "la", " ", "funci\[OAcute]n", " ", "de", " ", 
    "recurrencia"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "x_", "]"}], ":=", 
   RowBox[{"x", "-", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], "/", 
     RowBox[{
      RowBox[{"f", "'"}], "[", "x", "]"}]}]}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Se", " ", "calcula", " ", "primer", " ", "iterado", " ", "a", " ", 
    "partir", " ", "de", " ", 
    RowBox[{"aprox", ".", " ", "x0", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "=", 
