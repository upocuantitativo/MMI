     " ", "el", " ", "contador", " ", "de", " ", "la", " ", 
    RowBox[{"iteraci\[OAcute]n", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"incr", ">", "tol"}], ",", 
       RowBox[{"iter", "<", "maxiter"}]}], "}"}], "\[Equal]", 
