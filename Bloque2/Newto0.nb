     "considera", " ", "como", " ", "un", " ", "error", " ", "relativo", " ", 
     "entre", " ", "p", " ", "y", " ", 
     RowBox[{"x0", "."}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"iter", ":=", "2"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"incr", ":=", 
   RowBox[{"Abs", "[", 
    RowBox[{"N", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"p", "-", "x0"}], "p"], ",", 
      RowBox[{"Precision", "[", "tol", "]"}]}], "]"}], "]"}]}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Este", " ", "WHILE", " ", "funcionar\[AAcute]", " ", "mientras", " ", 
    "que", " ", "el", " ", "incremento", " ", "no", " ", "alcance", " ", "la",
     " ", "tolerancia", " ", "o", " ", "mientras", " ", "haya", " ", 
    "iteraciones", " ", "que", " ", 
    RowBox[{"hacer", ".", " ", "En"}], " ", "cada", " ", "iteraci\[OAcute]n", 
    " ", "guardar\[AAcute]", " ", "el", " ", "iterado", " ", "previamente", 
    " ", "obtenido", " ", "y", " ", "definir\[AAcute]", " ", "el", " ", 
    RowBox[{"siguiente", ".", "\[IndentingNewLine]", "Adem\[AAcute]s"}], " ", 
    "se", " ", "ha", " ", "considerado", " ", "como", " ", "criterio", " ", 
    "de", " ", "parada", " ", "la", " ", "condici\[OAcute]n", " ", "relativa",
     " ", "que", " ", "compara", " ", "dos", " ", "iterados", " ", 
