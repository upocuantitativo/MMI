      RowBox[{"q2", "-", "q1"}]]}], ";", 
    RowBox[{"incr", ":=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Abs", "[", 
        FractionBox[
         RowBox[{"p", "-", "x2"}], "p"], "]"}], ",", 
       RowBox[{"Precision", "[", "tol", "]"}]}], "]"}]}], ";", 
    RowBox[{"iter", "=", 
     RowBox[{"iter", "+", "1"}]}], ";", 
    RowBox[{"Print", "[", "p", "]"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"incr", ">", "tol"}], ",", 
   RowBox[{"Print", "[", "\"\<Insuficientes iteraciones\>\"", "]"}], ",", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<La soluci\[OAcute]n es \>\"", ",", "p"}], "]"}]}], 
  "]"}]}], "Input"],

