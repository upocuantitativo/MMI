Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  RowBox[{
  "Input", "[", "\"\<Introduce la funci\[OAcute]n a aproximar\>\"", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"x1", "=", 
  RowBox[{
  "Input", "[", "\"\<Introduce la primera aproximaci\[OAcute]n inicial\>\"", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"x2", "=", 
  RowBox[{
  "Input", "[", "\"\<Introduce la segunda aproximaci\[OAcute]n inicial\>\"", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"tol", "=", 
  RowBox[{
  "Input", "[", "\"\<Introduce la tolerancia\>\"", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"maxiter", "=", 
    RowBox[{
    "Input", "[", 
     "\"\<Introduce el n\[UAcute]mero m\[AAcute]ximo de iteraciones\>\"", 
     "]"}]}], "\[IndentingNewLine]"}], 
  RowBox[{"(*", 
   RowBox[{
   "C\[AAcute]lculo", " ", "de", " ", "las", " ", "im\[AAcute]genes", " ", 
    "de", " ", "los", " ", "extremos"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"q1", "=", 
  RowBox[{"f", "[", "x1", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"q2", "=", 
    RowBox[{"f", "[", "x2", "]"}]}], "\[IndentingNewLine]"}], 
  RowBox[{"(*", 
   RowBox[{
   "Se", " ", "reinicia", " ", "el", " ", "contador", " ", "de", " ", 
    "iteraciones", " ", "en", " ", "3"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"iter", ":=", "3"}], "\[IndentingNewLine]"}], 
  RowBox[{"(*", 
   RowBox[{
   "Se", " ", "calcula", " ", "el", " ", "iterado", " ", "a", " ", "partir", 
    " ", "de", " ", "los", " ", "dos", " ", "iniciales"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "=", 
    FractionBox[
     RowBox[{
      RowBox[{"x1", "*", "q2"}], "-", 
      RowBox[{"x2", "*", "q1"}]}], 
     RowBox[{"q2", "-", "q1"}]]}], "\[IndentingNewLine]"}], 
  RowBox[{"(*", 
   RowBox[{"Se", " ", "reinicia", " ", "el", " ", "error"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"incr", ":=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       FractionBox[
        RowBox[{"p", "-", "x2"}], "p"], "]"}], ",", 
      RowBox[{"Precision", "[", "tol", "]"}]}], "]"}]}], 
   "\[IndentingNewLine]"}], 
  RowBox[{"(*", 
   RowBox[{
   "Se", " ", "comienza", " ", "el", " ", "WHILE", " ", "para", " ", "ir", 
    " ", "aumentando", " ", "iteraciones", " ", "y", " ", "comprobando", " ", 
    "la", " ", "tolerancia"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"While", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"incr", ">", "tol"}], ",", 
      RowBox[{"iter", "<", "maxiter"}]}], "}"}], "\[Equal]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True"}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"x1", "=", "x2"}], ";", 
    RowBox[{"x2", "=", "p"}], ";", 
    RowBox[{"q1", "=", "q2"}], ";", 
    RowBox[{"q2", "=", 
     RowBox[{"f", "[", "p", "]"}]}], ";", 
    RowBox[{"p", "=", 
     FractionBox[
      RowBox[{
       RowBox[{"x1", "*", "q2"}], "-", 
